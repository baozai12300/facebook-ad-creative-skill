{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/render-payload.schema.json",
  "title": "Provider-Neutral Image Render Payload",
  "type": "object",
  "required": ["creative_id", "provider", "model", "product_images", "render_prompt", "placement", "evidence"],
  "properties": {
    "creative_id": { "type": "string" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "product_images": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } },
    "render_prompt": { "type": "string", "minLength": 1 },
    "placement": { "type": "object" },
    "evidence": { "type": "object" }
  },
  "additionalProperties": false
}
