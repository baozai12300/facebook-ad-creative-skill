{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/creative-preview-plan.schema.json",
  "title": "CreativePreviewPlan",
  "type": "object",
  "required": ["creative_id", "title", "status", "strategy", "visual", "copy", "placement", "evidence", "render_prompt", "quality", "typography_salience_check", "quality_pass", "layout_intelligence"],
  "properties": {
    "creative_id": { "type": "string" },
    "title": { "type": "string" },
    "status": { "enum": ["draft", "approved"] },
    "strategy": {
      "type": "object",
      "required": ["audience", "angle", "message"],
      "properties": { "audience": { "type": "string" }, "angle": { "type": "string" }, "message": { "type": "string" } }
    },
    "visual": {
      "type": "object",
      "required": ["scene", "product_action", "layout", "camera", "lighting", "visual_dna", "typography", "graphic_structure", "typography_structure", "structural_signature", "composition_geometry"],
      "properties": {
        "scene": { "type": "string" }, "product_action": { "type": "string" },
        "layout": { "type": "string" }, "camera": { "type": "string" },
        "lighting": { "type": "string" }, "visual_dna": { "type": "string" },
        "typography": { "type": "string" },
        "graphic_structure": { "type": "object" },
        "typography_structure": { "type": "object" },
        "structural_signature": { "type": "string" },
        "composition_geometry": { "type": "string" }
      }
    },
    "copy": { "type": "object", "required": ["headline", "support", "support_line", "micro_label", "caption", "index_label"], "properties": { "headline": { "type": "string" }, "support": { "type": "string" }, "support_line": { "type": "string" }, "micro_label": { "type": "string" }, "caption": { "type": "string" }, "index_label": { "type": "string" } } },
    "placement": { "type": "object", "required": ["platform", "placement", "ratio"], "properties": { "platform": { "type": "string" }, "placement": { "type": "string" }, "ratio": { "type": "string" } } },
    "evidence": { "type": "object", "required": ["claims_used", "sources", "copy_tiers"], "properties": { "claims_used": { "type": "array", "items": { "type": "string" } }, "sources": { "type": "array", "items": { "type": "string" } }, "copy_tiers": { "type": "object" } } },
    "render_prompt": { "type": "string", "minLength": 1 },
    "quality": { "type": "object" },
    "typography_salience_check": { "type": "object" },
    "quality_pass": { "type": "boolean" }
    ,"layout_intelligence": {
      "type": "object",
      "required": ["used", "strength", "match_level", "sample_count"],
      "properties": {
        "used": { "type": "boolean" },
        "strength": { "enum": ["strong", "medium", "soft", "none"] },
        "match_level": { "type": "string" },
        "sample_count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "additionalProperties": false
}
