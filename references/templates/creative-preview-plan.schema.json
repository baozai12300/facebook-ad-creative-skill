{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/creative-preview-plan.schema.json",
  "title": "CreativePreviewPlan",
  "type": "object",
  "required": ["creative_id", "title", "status", "strategy", "visual", "copy", "placement", "evidence", "render_prompt", "quality"],
  "properties": {
    "creative_id": { "type": "string" },
    "title": { "type": "string" },
    "status": { "enum": ["draft", "approved"] },
    "strategy": {
      "type": "object",
      "required": ["audience", "angle", "message"],
      "properties": { "audience": { "type": "string" }, "angle": { "type": "string" }, "message": { "type": "string" } }
    },
    "visual": {
      "type": "object",
      "required": ["scene", "product_action", "layout", "camera", "lighting", "visual_dna"],
      "properties": {
        "scene": { "type": "string" }, "product_action": { "type": "string" },
        "layout": { "type": "string" }, "camera": { "type": "string" },
        "lighting": { "type": "string" }, "visual_dna": { "type": "string" }
      }
    },
    "copy": { "type": "object", "required": ["headline", "support"], "properties": { "headline": { "type": "string" }, "support": { "type": "string" } } },
    "placement": { "type": "object", "required": ["platform", "placement", "ratio"], "properties": { "platform": { "type": "string" }, "placement": { "type": "string" }, "ratio": { "type": "string" } } },
    "evidence": { "type": "object", "required": ["claims_used", "sources"], "properties": { "claims_used": { "type": "array", "items": { "type": "string" } }, "sources": { "type": "array", "items": { "type": "string" } } } },
    "render_prompt": { "type": "string", "minLength": 1 },
    "quality": { "type": "object" }
  },
  "additionalProperties": false
}
