{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/facebook-ad-creative-output.schema.json",
  "title": "Facebook Ad Creative Skill Output",
  "type": "object",
  "required": ["schema_version", "input_summary", "creative_plans", "quality_checks"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "input_summary": { "type": "object" },
    "creative_plans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "creative_id", "hypothesis", "placement_plan", "visual_plan", "render_prompt", "model_prompts", "negative_constraints", "evidence_lock", "quality_check"],
        "properties": {
          "id": { "type": "string" },
          "creative_id": { "type": "string" },
          "hypothesis": {
            "type": "object",
            "required": ["audience", "awareness_stage", "objective", "angle", "core_benefit", "use_moment", "visible_behavior", "rationale"],
            "properties": {
              "audience": { "type": "string" },
              "awareness_stage": { "type": "string" },
              "objective": { "type": "string" },
              "angle": { "type": "string" },
              "core_benefit": { "type": "string" },
              "use_moment": { "type": "string" },
              "visible_behavior": { "type": "string" },
              "rationale": { "type": "string" }
            }
          },
          "placement_plan": {
            "type": "object",
            "required": ["placement", "aspect_ratio", "canvas", "safe_composition", "adaptation_notes", "native_ratio"]
          },
          "visual_plan": {
            "type": "object",
            "required": ["scene", "audience_scene_bridge", "visual_dna", "layout", "product_position", "headline_zone", "support_zone", "negative_space", "visual_flow", "text_mode", "copy"],
            "properties": {
              "scene": { "type": "string" },
              "layout": { "type": "string" },
              "product_position": { "type": "string" },
              "headline_zone": { "type": "string" },
              "support_zone": { "type": "string" },
              "negative_space": { "type": "string" },
              "visual_flow": { "type": "string" },
              "text_mode": { "type": "string" },
              "audience_scene_bridge": {
                "type": "object",
                "properties": {
                  "use_moment": { "type": "string" },
                  "visible_behavior": { "type": "string" },
                  "environment_cues": { "type": "array", "items": { "type": "string" } },
                  "prop_cues": { "type": "array", "items": { "type": "string" } },
                  "casting_direction": { "type": "string" },
                  "camera_language": { "type": "string" },
                  "copy_tone": { "type": "string" },
                  "why_it_fits": { "type": "string" }
                },
                "required": ["use_moment", "visible_behavior", "environment_cues", "prop_cues", "casting_direction", "camera_language", "copy_tone"]
              },
              "visual_dna": { "type": "object" },
              "copy": { "type": "object" }
            }
          },
          "render_prompt": { "type": "string", "minLength": 1 },
          "model_prompts": {
            "type": "object",
            "required": ["universal", "gpt_image_2", "nano_banana"],
            "properties": {
              "universal": { "type": "string" },
              "gpt_image_2": { "type": "string" },
              "nano_banana": { "type": "string" }
            }
          },
          "negative_constraints": { "type": "array", "items": { "type": "string" } },
          "evidence_lock": {
            "type": "object",
            "required": ["claim_mode", "used_claims", "evidence_source"],
            "properties": {
              "claim_mode": { "enum": ["visual_only", "evidence_backed"] },
              "used_claims": { "type": "array", "items": { "type": "string" } },
              "evidence_source": { "type": "array", "items": { "type": "string" } }
            }
          },
          "quality_check": {
            "type": "object",
            "required": ["pass", "findings", "revised", "prompt_word_count", "checks"]
          }
        }
      }
    },
    "quality_checks": {
      "type": "object",
      "required": ["pass", "findings", "distinct_angles", "distinct_layouts", "distinct_hypothesis_combinations"]
    }
  }
}
