{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/facebook-ad-creative-output.schema.json",
  "title": "Facebook Ad Creative Skill Output",
  "type": "object",
  "required": ["input_summary", "creative_plans", "quality_checks"],
  "properties": {
    "input_summary": { "type": "object" },
    "creative_plans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "creative_plan", "model_prompts"],
        "properties": {
          "id": { "type": "string" },
          "creative_plan": {
            "type": "object",
            "properties": {
              "target_audience": { "type": "string" },
              "interest_cues": { "type": "array", "items": { "type": "string" } },
              "pain_point": { "type": "string" },
              "core_benefit": { "type": "string" },
              "angle": { "type": "string" },
              "scene": { "type": "string" },
              "style": { "type": "string" },
              "layout": { "type": "string" },
              "audience_scene_bridge": {
                "type": "object",
                "properties": {
                  "use_moment": { "type": "string" },
                  "visible_behavior": { "type": "string" },
                  "environment_cues": { "type": "array", "items": { "type": "string" } },
                  "prop_cues": { "type": "array", "items": { "type": "string" } },
                  "casting_direction": { "type": "string" },
                  "camera_language": { "type": "string" },
                  "copy_tone": { "type": "string" },
                  "why_it_fits": { "type": "string" }
                },
                "required": ["use_moment", "visible_behavior", "environment_cues", "prop_cues", "casting_direction", "camera_language", "copy_tone", "why_it_fits"]
              },
              "copy": { "type": "object" },
              "difference_statement": { "type": "string" }
            }
          },
          "model_prompts": {
            "type": "object",
            "properties": {
              "universal": { "type": "string" },
              "gpt_image_2": { "type": "string" },
              "nano_banana": { "type": "string" },
              "negative_constraints": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "quality_checks": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
